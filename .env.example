# Copy to .env and fill in. Everything here is optional except the athlete
# zones — each missing key just disables its feature (see README "Degrading
# gracefully"). The pipeline runs with an empty .env; it just runs dumber.

# --- Gemini: the vision scan. Without it, candidates come from telemetry ---
# --- and Strava only, which is where the interesting moments aren't. ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Strava: segment popularity. Optional. ---
# Register an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Garmin Connect: only for `garmin-download`. Skip both if you copy ---
# --- the .fit off the device yourself. ---
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- OpenStreetMap: your email. Nominatim's usage policy requires a real ---
# --- contact address. Unset = no GPS-derived origin/destination/road. ---
# https://operations.osmfoundation.org/policies/nominatim/
OSM_CONTACT_EMAIL=

# --- SET THESE. The defaults are one rider's numbers and are probably not ---
# --- yours. They drive three things: the spike thresholds below, the HUD's ---
# --- power/HR zone colors, and the power zones handed to the vision model ---
# --- so it knows whether 216W means "cruising" or "peak effort" for you. ---
FTP=240
MAX_HEART_RATE=196

# --- Spike thresholds. Leave commented to scale off FTP / MAX_HEART_RATE ---
# --- (~1.45x FTP, ~87% max HR). Uncomment only to hand-tune. ---
# POWER_SPIKE_THRESHOLD=350
# HR_SPIKE_THRESHOLD=170
SPEED_SPIKE_THRESHOLD=12.0

# --- Frame sampling (fallback if native video upload fails) ---
SAMPLE_FPS=2.0
SAMPLE_MAX_WIDTH=640
MAX_FRAMES_PER_CLIP=16
MOTION_FRAME_RATIO=0.5

# Scoring version (for A/B testing models)
SCORE_VERSION=v1

# Paths
DATA_DIR=data
